DRY_RUN=true
AUTO_SEND=false
AUTO_SEND_KILL_SWITCH=true
AUTOMATION_MODE=SEMI_AUTO
HUNT_INTERVAL_MINUTES=15
# Para caçar continuamente sem esperar minutos entre os ciclos:
# HUNT_INTERVAL_MINUTES=0
# RUN_FOREVER=true
AUTO_SEND_MIN_SCORE=85
MIN_CONFIDENCE=0.75
MAX_PROPOSALS_PER_HOUR=3
MAX_PROPOSALS_PER_DAY=10
HTTP_TIMEOUT=15
AI_PROVIDER=local
AI_BASE_URL=http://localhost:8080/v1
AI_MODEL=model-name
DATABASE_PATH=freelahunter.db
DISCORD_WEBHOOK_URL=
INBOX_POLL_SECONDS=60
MAX_PROPOSALS_PER_CLIENT_24H=1
AUTO_MESSAGE_ON_LIMIT=false
MAX_MESSAGES_PER_CLIENT_24H=1
STOP_AFTER_IDLE_CYCLES=3
STRUCTURED_LOGS=true
ACTION_DELAY_MIN_MS=350
ACTION_DELAY_MAX_MS=1200
PAUSE_NO_RESPONSE_DAYS=7
PAUSE_CONSECUTIVE_NO_RESPONSE=5
PAUSE_REJECTION_THRESHOLD=0.6
# Decisões (aceitas/rejeitadas) mínimas antes de pausar por taxa de rejeição
PAUSE_MIN_DECIDED=5

# Estilo do texto das propostas: vazio = teste A/B automático entre A, B e C
# (depois de 15 envios por estilo, o de maior taxa de resposta passa a ser o
# principal). Defina A, B ou C para fixar um estilo.
PROPOSAL_STYLE=

# Webhook JSON opcional (ex.: n8n -> WhatsApp/CRM). Eventos: client_reply,
# proposal_sent, message_sent, automation_paused. Token vai como Bearer.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Plataformas: 99freelas, upwork, workana
PLATFORM=99freelas
# Workana gera rascunhos locais; seletores reais ainda precisam de validação.
# Reinícios máximos após desconexão do navegador (comandos npm/painel).
BROWSER_RESTART_LIMIT=3
# Filtros e pontuação das vagas: config/hunt_filters.json
